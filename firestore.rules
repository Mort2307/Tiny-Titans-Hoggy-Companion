rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasCreatorClaim() {
      return signedIn() && (
        request.auth.token.creator == true ||
        request.auth.token.admin == true
      );
    }
    function hasModeratorClaim() {
      return signedIn() && (
        request.auth.token.moderator == true ||
        request.auth.token.creator == true ||
        request.auth.token.admin == true
      );
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }
    function isTester() {
      return signedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTester == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "tester"
      );
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == "user";
      allow get: if signedIn() && (request.auth.uid == userId || hasCreatorClaim());
      allow list: if hasCreatorClaim();
      allow update: if signedIn() && (isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && (request.auth.uid == userId || hasCreatorClaim());
    }

    match /supporters/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || hasCreatorClaim());
      allow list: if hasCreatorClaim();
      allow create, update, delete: if isAdmin();
    }

    match /supporterStats/{statId} {
      allow read, write: if isAdmin();
    }

    match /issueReports/{reportId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if signedIn() && (hasModeratorClaim() || resource.data.userId == request.auth.uid);
      allow list: if hasModeratorClaim() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if hasModeratorClaim();
    }

    match /founderApplications/{applicationId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if hasCreatorClaim();
    }

    match /communityPosts/{postId} {
      allow read: if signedIn() && (
        resource.data.audience == "everyone" ||
        (resource.data.audience == "testers" && isTester()) ||
        (resource.data.audience == "admin" && hasCreatorClaim())
      );
      allow create, update, delete: if hasCreatorClaim();
    }

    match /morphImageSubmissions/{submissionId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if signedIn() && (request.auth.uid == resource.data.userId || hasModeratorClaim());
      allow list: if hasModeratorClaim();
      allow update, delete: if hasModeratorClaim();
    }

    match /approvedMorphImages/{imageId} {
      allow read: if signedIn();
      allow create, update, delete: if hasModeratorClaim();
    }

    match /creatorAggregates/{aggregateId} {
      allow read: if hasCreatorClaim();
      allow write: if false;
    }

    match /testerRuns/{runId} {
      allow read: if hasCreatorClaim() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if hasCreatorClaim() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if hasCreatorClaim() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
