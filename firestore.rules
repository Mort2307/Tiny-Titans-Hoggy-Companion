rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Every signed-in user may read their own profile. Admins may read/list
    // the user collection. Keeping the personal get rule independent of
    // isAdmin() avoids an unnecessary recursive permission dependency.
    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user";

      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isAdmin();

      allow update: if signedIn() && (
        isAdmin()
        || (request.auth.uid == userId
          && request.resource.data.role == resource.data.role)
      );

      allow delete: if isAdmin();
    }

    // Admins can access user-owned subcollections for global Creator Centre
    // statistics; owners retain access to their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn()
        && (request.auth.uid == userId || isAdmin());
    }

    match /supporters/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /supporterStats/{statId} {
      allow read, write: if isAdmin();
    }

    match /issueReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /founderApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
