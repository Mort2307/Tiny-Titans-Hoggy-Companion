rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerAccount() { return signedIn() && request.auth.token.email == 'tinytitans.exotics@gmail.com'; }
    function userRecord() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasCapability(capability) { return signedIn() && (ownerAccount() || request.auth.token.admin == true || request.auth.token[capability] == true); }
    function isCreator() { return ownerAccount(); }
    function isTester() { return ownerAccount(); }
    function isEducator() { return hasCapability('educator'); }
    function isModerator() { return hasCapability('moderator'); }
    function familyMemberOf(userId) { return signedIn() && request.auth.uid != userId && userRecord().get('familyId', '') != '' && userRecord().get('familyId', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('familyId', '') && get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))).data.memberUids.hasAll([request.auth.uid, userId]); }
    function familyPermission(userId, area, action) { return familyMemberOf(userId) && (!exists(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)) || get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)).data.get('permissions', {}).get(area + '.' + action, 'allow') == 'allow'); }
    // Review/sandbox family accounts must never acquire breeding write rights because
    // a permissions document is absent. Explicit approval is executed by the owner.
    function breedingFamilyPermission(userId, action) {
      return familyMemberOf(userId)
        && exists(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)).data.get('accessMode', 'review') == 'full'
          || (
            get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)).data.get('accessMode', 'review') == 'review'
            && get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)).data.get('permissions', {}).get('breeding.' + action, 'verify') == 'allow'
          )
        );
    }
    function familyViewPermission(userId, area) { return familyMemberOf(userId) && (!exists(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)) || get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)).data.get('permissions', {}).get(area + '.view', 'allow') != 'deny'); }
    function inviteTargetMatchesCurrentAccount(inviteId) { return signedIn() && (get(/databases/$(database)/documents/familyInvites/$(inviteId)).data.get('targetEmail', '') == request.auth.token.email || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == get(/databases/$(database)/documents/familyInvites/$(inviteId)).data.get('targetEmail', '')); }
    function canBindAcceptedFamilyProfile() { return signedIn() && request.resource.data.get('familyId', '') != '' && get(/databases/$(database)/documents/families/$(request.resource.data.get('familyId', ''))).data.memberUids.hasAll([request.auth.uid]) && get(/databases/$(database)/documents/families/$(request.resource.data.get('familyId', ''))).data.get('ownerUid', '') != request.auth.uid; }
    function familyOwner(familyId) { return signedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.get('ownerUid', '') == request.auth.uid; }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == "user";
      allow get: if signedIn() && (request.auth.uid == userId || familyMemberOf(userId) || isCreator());
      allow list: if isCreator();
      allow update: if signedIn() && (isCreator() || (request.auth.uid == userId && request.resource.data.role == resource.data.role) || (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId', 'familyRole']) && canBindAcceptedFamilyProfile()) || (familyMemberOf(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId', 'familyRole'])));
      allow delete: if isCreator();
    }
    match /users/{userId}/{document=**} { allow read: if signedIn() && (request.auth.uid == userId || isCreator()); allow write: if signedIn() && (request.auth.uid == userId || isCreator()); }
    match /users/{userId}/animals/{animalId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'animals'));
      allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'animals', 'create'));
      allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'animals', 'edit'));
      allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'animals', 'delete'));
    }
    match /users/{userId}/snakes/{snakeId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'snakes')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'snakes', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'snakes', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'snakes', 'delete')); match /weights/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'weights')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'weights', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'weights', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'weights', 'delete')); } match /feedings/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'feeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'feeding', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'feeding', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'feeding', 'delete')); } match /sheds/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'sheds')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'sheds', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'sheds', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'sheds', 'delete')); } match /health/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'health')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'health', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'health', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'health', 'delete')); } match /behaviours/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'behaviour')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'behaviour', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'behaviour', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'behaviour', 'delete')); } }
    match /users/{userId}/breedingProjects/{projectId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'delete')); match /pairings/{pairingId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'delete')); } match /clutches/{clutchId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'delete')); } match /hatchlings/{hatchlingId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'delete')); } match /events/{eventId} {
        allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding'));
        allow create: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'create'))
          && exists(/databases/$(database)/documents/users/$(userId)/breedingProjects/$(projectId))
          && request.resource.data.get('projectId', '') == projectId
          && request.resource.data.get('id', '') == eventId
          && request.resource.data.get('speciesId', '') == get(/databases/$(database)/documents/users/$(userId)/breedingProjects/$(projectId)).data.get('speciesId', '');
        allow update: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'edit'))
          && request.resource.data.get('projectId', '') == projectId
          && request.resource.data.get('id', '') == eventId
          && request.resource.data.get('speciesId', '') == resource.data.get('speciesId', '')
          && request.resource.data.get('speciesId', '') == get(/databases/$(database)/documents/users/$(userId)/breedingProjects/$(projectId)).data.get('speciesId', '');
        allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || breedingFamilyPermission(userId, 'delete'));
      } }
    match /families/{familyId} { allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.memberUids == [request.auth.uid] && request.resource.data.members.size() == 1; allow get: if signedIn() && (request.auth.uid in resource.data.memberUids || isCreator()); allow list: if false; allow update: if signedIn() && ((resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.memberUids.size() <= 3) || (request.auth.uid in request.resource.data.memberUids && !(request.auth.uid in resource.data.memberUids) && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 && request.resource.data.memberUids.hasAll(resource.data.memberUids) && request.resource.data.get('acceptingInviteId', '') != '' && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.get('acceptingInviteId', ''))).data.get('familyId', '') == familyId && inviteTargetMatchesCurrentAccount(request.resource.data.get('acceptingInviteId', '')) && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.get('acceptingInviteId', ''))).data.get('status', '') == 'pending')); allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid; match /permissions/{memberUid} { allow get: if signedIn() && (request.auth.uid == memberUid || familyOwner(familyId)); allow list: if familyOwner(familyId); allow create, update: if familyOwner(familyId) && request.resource.data.memberUid == memberUid; allow delete: if familyOwner(familyId); } }
    match /familyInvites/{inviteId} { allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerUid == request.auth.uid && request.resource.data.targetEmail is string && request.resource.data.status == 'pending'; allow get, list: if signedIn() && (isCreator() || resource.data.ownerUid == request.auth.uid || inviteTargetMatchesCurrentAccount(resource.id)); allow update: if signedIn() && ((resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid) || (inviteTargetMatchesCurrentAccount(resource.id) && request.resource.data.targetEmail == resource.data.targetEmail && request.resource.data.familyId == resource.data.familyId && request.resource.data.status in ['accepted', 'declined'])); allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid; }
    match /familyApprovals/{approvalId} { allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.familyId == userRecord().get('familyId', '') && request.resource.data.status == 'pending'; allow get: if signedIn() && (isCreator() || resource.data.requesterUid == request.auth.uid || get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerUid == request.auth.uid); allow list: if isCreator(); allow update: if signedIn() && get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedByUid', 'decidedAt']) && request.resource.data.status in ['approved', 'rejected']; allow delete: if false; }
    match /sandboxExperiments/{experimentId} { allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.type in ['genetics', 'pairing', 'clutch', 'custom']; allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid; allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid; }
    match /testerSandboxes/{sandboxId} { allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.syntheticOnly == true && request.resource.data.purpose == "bot-test"; allow get: if signedIn() && resource.data.ownerUid == request.auth.uid; allow update: if signedIn() && request.auth.uid == resource.data.ownerUid && request.resource.data.syntheticOnly == true; allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid; allow list: if false; match /{document=**} { allow read, write: if signedIn() && get(/databases/$(database)/documents/testerSandboxes/$(sandboxId)).data.ownerUid == request.auth.uid; } }
    match /geneticsCalculations/{calculationId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow get, list: if isCreator(); allow update, delete: if isCreator(); }
    match /supporters/{userId} { allow get: if signedIn() && (request.auth.uid == userId || isCreator()); allow list: if isCreator(); allow create, update, delete: if isCreator(); }
    match /supporterWall/{entryId} { allow read: if signedIn(); allow create, update, delete: if isCreator(); }
    match /supporterStats/{statId} { allow read, write: if isCreator(); }
    match /issueReports/{reportId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow get: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid); allow list: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid); allow update, delete: if isCreator(); match /messages/{messageId} { allow read: if signedIn() && (isCreator() || get(/databases/$(database)/documents/issueReports/$(reportId)).data.userId == request.auth.uid); allow create: if signedIn() && (isCreator() || get(/databases/$(database)/documents/issueReports/$(reportId)).data.userId == request.auth.uid) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == (isCreator() ? "creator" : "user"); allow update, delete: if false; } }
    match /feedback/{feedbackId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow get: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid); allow list: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid); allow update, delete: if isCreator(); match /messages/{messageId} { allow read: if signedIn() && (isCreator() || get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid); allow create: if signedIn() && (isCreator() || get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == (isCreator() ? "creator" : "user"); allow update, delete: if false; } }
    match /submissionConversations/{conversationId} { allow create: if signedIn() && (isCreator() || request.resource.data.submitterUid == request.auth.uid) && request.resource.data.submissionId is string && request.resource.data.submissionType is string; allow get: if signedIn() && (isCreator() || resource.data.submitterUid == request.auth.uid); allow list: if signedIn() && (isCreator() || resource.data.submitterUid == request.auth.uid); allow update: if signedIn() && (isCreator() || resource.data.submitterUid == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessageAt', 'lastMessagePreview', 'lastSenderRole', 'unreadForSubmitter', 'unreadForCreator', 'submissionStatus', 'contributorThankedAt']); allow delete: if false; match /messages/{messageId} { allow get, list: if signedIn() && (isCreator() || get(/databases/$(database)/documents/submissionConversations/$(conversationId)).data.submitterUid == request.auth.uid); allow create: if signedIn() && (isCreator() || get(/databases/$(database)/documents/submissionConversations/$(conversationId)).data.submitterUid == request.auth.uid) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == "creator"; allow update, delete: if false; } }
    match /founderApplications/{applicationId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow get: if signedIn() && (isCreator() || resource.data.uid == request.auth.uid); allow list: if isCreator() || (signedIn() && resource.data.uid == request.auth.uid); allow update, delete: if isCreator(); }
    match /communityPosts/{postId} { allow read: if signedIn() && (resource.data.audience == "everyone" || (resource.data.audience == "testers" && isTester()) || (resource.data.audience == "educator" && isEducator()) || (resource.data.audience == "moderator" && isModerator()) || (resource.data.audience == "admin" && isCreator())); allow create, update, delete: if isCreator(); }
    match /morphSubmissions/{submissionId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "creating" && request.resource.data.moderationStatus == "pending" && request.resource.data.submissionComplete == false; allow get: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid); allow list: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid); allow update, delete: if isCreator(); }
    match /morphImageSubmissions/{submissionId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow get: if signedIn() && (request.auth.uid == resource.data.userId || isCreator()); allow list: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid); allow update, delete: if isCreator(); }
    match /vivariumShowcaseSubmissions/{submissionId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "Pending" && request.resource.data.publicConsent == true; allow get: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid || (resource.data.status == "Approved" && resource.data.publicConsent == true)); allow list: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid) || (signedIn() && resource.data.status == "Approved" && resource.data.publicConsent == true); allow update: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.status == resource.data.status); allow delete: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status != "Approved"); }
    match /{path=**}/morphSubmissions/{submissionId} { allow read: if isCreator(); allow update, delete: if isCreator(); }
    match /approvedMorphImages/{imageId} { allow read: if signedIn(); allow create, update, delete: if isCreator(); }
    match /variationCardSubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'speciesId', 'speciesName', 'submittedName', 'region', 'category',
          'description', 'knownGenetics', 'sourceOrBreeder', 'sourceUrl', 'status',
          'createdAt', 'updatedAt', 'serverCreatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.speciesId is string
        && request.resource.data.speciesId.size() > 0
        && request.resource.data.speciesName is string
        && request.resource.data.speciesName.size() > 0
        && request.resource.data.speciesName.size() <= 240
        && request.resource.data.submittedName is string
        && request.resource.data.submittedName.size() >= 2
        && request.resource.data.submittedName.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 4000
        && request.resource.data.region in ['global', 'uk', 'usa', 'europe', 'australia', 'other']
        && request.resource.data.category in [
          'single-gene', 'super-form', 'combination', 'polygenic', 'line-bred',
          'colour-variation', 'pattern-variation', 'locality', 'regional-name', 'unknown'
        ]
        && request.resource.data.knownGenetics is string
        && request.resource.data.knownGenetics.size() <= 4000
        && request.resource.data.sourceOrBreeder is string
        && request.resource.data.sourceOrBreeder.size() <= 1000
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 2048
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.serverCreatedAt is timestamp;
      allow get, list: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid);
      allow update, delete: if isCreator();
    }
    match /approvedMorphVariations/{variationId} { allow read: if signedIn(); allow create, update, delete: if isCreator(); }
    match /mentorApplications/{applicationId} { allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid && request.resource.data.status == "submitted" && request.resource.data.mentorRoles.size() > 0 && request.resource.data.specialities.size() > 0 && request.resource.data.experienceYears >= 0 && request.resource.data.experienceYears <= 80 && request.resource.data.conductAccepted == true; allow get: if signedIn() && (isCreator() || resource.data.applicantId == request.auth.uid); allow list: if isCreator(); allow update, delete: if isCreator(); }
    match /mentors/{mentorId} { allow read: if signedIn(); allow create, update, delete: if isCreator(); }
    match /mentorshipRequests/{requestId} { allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid && request.resource.data.status == "sent"; allow get, list: if signedIn() && (isCreator() || resource.data.requesterId == request.auth.uid || resource.data.mentorId == request.auth.uid); allow update: if signedIn() && (isCreator() || resource.data.mentorId == request.auth.uid || resource.data.requesterId == request.auth.uid); allow delete: if isCreator(); }
    match /mentorshipWorkspaces/{workspaceId} { allow create: if signedIn() && (isCreator() || request.resource.data.participants.any(p, p.userId == request.auth.uid)); allow get: if signedIn() && (isCreator() || resource.data.participants.any(p, p.userId == request.auth.uid)); allow list: if false; allow update: if signedIn() && (isCreator() || resource.data.participants.any(p, p.userId == request.auth.uid)); allow delete: if isCreator(); }
    match /mentorshipEvents/{eventId} { allow create: if isCreator(); allow get, list: if isCreator(); allow update, delete: if isCreator(); }
    match /foundingFollowerClaims/{claimId} {
      allow get: if signedIn() && (request.auth.uid == claimId || isCreator());
      allow list: if isCreator();
      allow create, update, delete: if false;
    }

    match /keeperObservations/{observationId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "pending" && request.resource.data.educationalConsent == true; allow get, list: if signedIn() && ((resource.data.status == "approved" && resource.data.educationalConsent == true) || resource.data.userId == request.auth.uid || isCreator()); allow update: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status == "pending" && request.resource.data.status == "pending" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['media', 'updatedAt'])); allow delete: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status == "pending"); }

    function activeRescueTier(uid) {
      return signedIn() && (
        (exists(/databases/$(database)/documents/paidEntitlements/$(uid)) && get(/databases/$(database)/documents/paidEntitlements/$(uid)).data.get('active', false) == true && get(/databases/$(database)/documents/paidEntitlements/$(uid)).data.get('tier', '') == 'rescue' && get(/databases/$(database)/documents/paidEntitlements/$(uid)).data.get('status', '') in ['active', 'trialing'])
        || (exists(/databases/$(database)/documents/paidTrials/$(uid)) && get(/databases/$(database)/documents/paidTrials/$(uid)).data.get('enabled', false) == true && get(/databases/$(database)/documents/paidTrials/$(uid)).data.get('tier', '') == 'rescue' && get(/databases/$(database)/documents/paidTrials/$(uid)).data.get('expiresAt', null) > request.time)
        || (exists(/databases/$(database)/documents/paidTesterOverrides/$(uid)) && get(/databases/$(database)/documents/paidTesterOverrides/$(uid)).data.get('enabled', false) == true && get(/databases/$(database)/documents/paidTesterOverrides/$(uid)).data.get('tier', '') == 'rescue' && (!get(/databases/$(database)/documents/paidTesterOverrides/$(uid)).data.get('expiresAt', null) || get(/databases/$(database)/documents/paidTesterOverrides/$(uid)).data.get('expiresAt', null) > request.time))
      );
    }
    function rescuePilotActive(orgId) {
      return get(/databases/$(database)/documents/rescueOrganisations/$(orgId)).data.get('pilotStatus', '') == 'pilot_active' && get(/databases/$(database)/documents/rescueOrganisations/$(orgId)).data.get('pilotEndsAt', null) > request.time;
    }
    function rescueWorkspaceEnabled(orgId) {
      let org = get(/databases/$(database)/documents/rescueOrganisations/$(orgId)).data;
      return org.get('accountType', 'rescue') == 'rescue' && (ownerAccount() || rescuePilotActive(orgId) || activeRescueTier(request.auth.uid) || activeRescueTier(org.get('ownerUid', '')));
    }
    function rescueOrgMember(orgId) {
      let org = get(/databases/$(database)/documents/rescueOrganisations/$(orgId)).data;
      return signedIn() && rescueWorkspaceEnabled(orgId) && (org.get('ownerUid', '') == request.auth.uid || request.auth.uid in org.get('managerUids', []) || request.auth.uid in org.get('staffUids', []) || request.auth.uid in org.get('medicalUids', []) || request.auth.uid in org.get('fosterUids', []) || request.auth.uid in org.get('viewerUids', []));
    }
    function rescueOrgEditor(orgId) {
      let org = get(/databases/$(database)/documents/rescueOrganisations/$(orgId)).data;
      return signedIn() && rescueWorkspaceEnabled(orgId) && (org.get('ownerUid', '') == request.auth.uid || request.auth.uid in org.get('managerUids', []) || request.auth.uid in org.get('staffUids', []) || request.auth.uid in org.get('medicalUids', []));
    }
    function rescueWritesEnabled() {
      return !exists(/databases/$(database)/documents/platformControls/rescue) || get(/databases/$(database)/documents/platformControls/rescue).data.get('writesEnabled', true) != false;
    }
    match /rescueOrganisations/{orgId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.accountType == 'rescue' && (request.resource.data.accountStatus == 'pilot_pending' || (request.resource.data.accountStatus == 'paid_active' && activeRescueTier(request.auth.uid)));
      allow get, list: if signedIn() && (resource.data.ownerUid == request.auth.uid || rescueOrgMember(orgId) || isCreator());
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && rescueWorkspaceEnabled(orgId) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.accountType == 'rescue' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'managerUids', 'staffUids', 'medicalUids', 'fosterUids', 'viewerUids', 'speciesDiscovered', 'staffLimit', 'animalLimit', 'storageMbLimit', 'animalCount', 'updatedAt']) && request.resource.data.managerUids.size() + request.resource.data.staffUids.size() + request.resource.data.medicalUids.size() + request.resource.data.fosterUids.size() + request.resource.data.viewerUids.size() <= request.resource.data.get('staffLimit', 5);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid && (activeRescueTier(request.auth.uid) || ownerAccount());
    }
    match /rescueAnimals/{animalId} {
      allow get: if rescueOrgMember(resource.data.organisationId);
      allow list: if rescueOrgMember(resource.data.organisationId);
      allow create: if rescueWritesEnabled() && signedIn() && request.resource.data.organisationId is string && rescueOrgEditor(request.resource.data.organisationId) && request.resource.data.publicPreview is bool;
      allow update: if rescueWritesEnabled() && rescueOrgEditor(resource.data.organisationId) && request.resource.data.organisationId == resource.data.organisationId && request.resource.data.publicPreview is bool;
      allow delete: if rescueWritesEnabled() && signedIn() && get(/databases/$(database)/documents/rescueOrganisations/$(resource.data.organisationId)).data.ownerUid == request.auth.uid && rescueWorkspaceEnabled(resource.data.organisationId);
    }
    match /rescueAnimalPublic/{animalId} {
      allow get: if resource.data.publicPreview == true;
      allow list: if false;
      allow create: if rescueWritesEnabled() && rescueOrgEditor(request.resource.data.organisationId) && request.resource.data.publicPreview == true && request.resource.data.keys().hasOnly(['organisationId', 'publicPreview', 'name', 'speciesCommonName', 'scientificName', 'universalSpeciesId', 'sex', 'morphOrColour', 'estimatedAge', 'status', 'intakeDate', 'publicSummary', 'timeline', 'createdAt', 'updatedAt']);
      allow update: if rescueWritesEnabled() && rescueOrgEditor(resource.data.organisationId) && request.resource.data.organisationId == resource.data.organisationId && request.resource.data.publicPreview == true && request.resource.data.keys().hasOnly(['organisationId', 'publicPreview', 'name', 'speciesCommonName', 'scientificName', 'universalSpeciesId', 'sex', 'morphOrColour', 'estimatedAge', 'status', 'intakeDate', 'publicSummary', 'timeline', 'createdAt', 'updatedAt']);
      allow delete: if rescueWritesEnabled() && rescueOrgEditor(resource.data.organisationId);
    }
    match /husbandrySafetyLibrary/{itemId} { allow read: if signedIn(); allow create, update, delete: if hasCapability('creator'); }
    match /husbandrySafetyAudit/{auditId} { allow read, create: if hasCapability('creator'); allow update, delete: if false; }
    function partnerOwner(uid) {
      return signedIn() && request.auth.uid == uid && exists(/databases/$(database)/documents/users/$(uid)) && get(/databases/$(database)/documents/users/$(uid)).data.profileType == 'professional';
    }
    match /partnerLandings/{landingId} {
      allow get: if resource.data.publicEnabled == true || (isCreator() && resource.data.recordType == 'owner') || partnerOwner(resource.data.ownerUid);
      allow list: if isCreator() && resource.data.recordType == 'owner';
      allow create: if partnerOwner(request.resource.data.ownerUid) && request.resource.data.recordType == 'owner';
      allow update: if isCreator() || (partnerOwner(resource.data.ownerUid) && resource.data.recordType == 'owner' && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.recordType == 'owner');
      allow delete: if isCreator() || (partnerOwner(resource.data.ownerUid) && resource.data.recordType == 'owner');
    }
    match /qaRuns/{runId} {
      allow get, list: if isCreator();
      allow create, update: if isCreator();
      allow delete: if isCreator();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
