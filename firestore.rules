rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerAccount() { return signedIn() && request.auth.token.email == 'tinytitans.exotics@gmail.com'; }
    function userRecord() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasCapability(capability) { return signedIn() && (request.auth.token.admin == true || request.auth.token[capability] == true); }
    function isCreator() { return ownerAccount() && (request.auth.token.admin == true || request.auth.token.creator == true); }
    function isTester() { return ownerAccount() && (request.auth.token.admin == true || request.auth.token.tester == true); }
    function isEducator() { return hasCapability('educator'); }
    function isModerator() { return hasCapability('moderator'); }
    function familyMemberOf(userId) { return signedIn() && request.auth.uid != userId && userRecord().get('familyId', '') != '' && userRecord().get('familyId', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('familyId', '') && get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))).data.memberUids.hasAll([request.auth.uid, userId]); }
    function familyPermission(userId, area, action) { return familyMemberOf(userId) && (!exists(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)) || get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)).data.get('permissions', {}).get(area + '.' + action, 'allow') == 'allow'); }
    function familyViewPermission(userId, area) { return familyMemberOf(userId) && (!exists(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)) || get(/databases/$(database)/documents/families/$(userRecord().get('familyId', ''))/permissions/$(request.auth.uid)).data.get('permissions', {}).get(area + '.view', 'allow') != 'deny'); }
    function inviteTargetMatchesCurrentAccount(inviteId) { return signedIn() && (get(/databases/$(database)/documents/familyInvites/$(inviteId)).data.get('targetEmail', '') == request.auth.token.email || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == get(/databases/$(database)/documents/familyInvites/$(inviteId)).data.get('targetEmail', '')); }
    function canBindAcceptedFamilyProfile() { return signedIn() && request.resource.data.get('familyId', '') != '' && get(/databases/$(database)/documents/families/$(request.resource.data.get('familyId', ''))).data.memberUids.hasAll([request.auth.uid]) && get(/databases/$(database)/documents/families/$(request.resource.data.get('familyId', ''))).data.get('ownerUid', '') != request.auth.uid; }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == "user";
      allow get: if signedIn() && (request.auth.uid == userId || familyMemberOf(userId) || isCreator());
      allow list: if isCreator();
      allow update: if signedIn() && (isCreator() || (request.auth.uid == userId && request.resource.data.role == resource.data.role) || (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId', 'familyRole']) && canBindAcceptedFamilyProfile()) || (familyMemberOf(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId', 'familyRole'])));
      allow delete: if isCreator();
    }
    match /users/{userId}/{document=**} { allow read: if signedIn() && (request.auth.uid == userId || isCreator()); allow write: if signedIn() && (request.auth.uid == userId || isCreator()); }
    match /users/{userId}/snakes/{snakeId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'snakes')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'snakes', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'snakes', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'snakes', 'delete')); match /weights/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'weights')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'weights', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'weights', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'weights', 'delete')); } match /feedings/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'feeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'feeding', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'feeding', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'feeding', 'delete')); } match /sheds/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'sheds')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'sheds', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'sheds', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'sheds', 'delete')); } match /health/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'health', 'create')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'health', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'health', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'health', 'delete')); } match /behaviours/{recordId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'behaviour', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'behaviour', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'behaviour', 'delete')); } }
    match /users/{userId}/breedingProjects/{projectId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'update')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'delete')); match /pairings/{pairingId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'delete')); } match /clutches/{clutchId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'delete')); } match /hatchlings/{hatchlingId} { allow read: if signedIn() && (request.auth.uid == userId || isCreator() || familyViewPermission(userId, 'breeding')); allow create: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'create')); allow update: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'edit')); allow delete: if signedIn() && (request.auth.uid == userId || isCreator() || familyPermission(userId, 'breeding', 'delete')); } }
    match /families/{familyId} { allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.memberUids == [request.auth.uid] && request.resource.data.members.size() == 1; allow get: if signedIn() && (request.auth.uid in resource.data.memberUids || isCreator()); allow list: if false; allow update: if signedIn() && ((resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.memberUids.size() <= 3) || (request.auth.uid in request.resource.data.memberUids && !(request.auth.uid in resource.data.memberUids) && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 && request.resource.data.memberUids.hasAll(resource.data.memberUids) && request.resource.data.get('acceptingInviteId', '') != '' && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.get('acceptingInviteId', ''))).data.get('familyId', '') == familyId && inviteTargetMatchesCurrentAccount(request.resource.data.get('acceptingInviteId', '')) && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.get('acceptingInviteId', ''))).data.get('status', '') == 'pending')); allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid; match /permissions/{memberUid} { allow get: if signedIn() && (request.auth.uid == memberUid || (resource.data.get('familyId', '') == familyId && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid)); allow list: if signedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid; allow create, update: if signedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid && request.resource.data.memberUid == memberUid; allow delete: if signedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid; } }
    match /familyInvites/{inviteId} { allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerUid == request.auth.uid && request.resource.data.targetEmail is string && request.resource.data.status == 'pending'; allow get, list: if signedIn() && (isCreator() || resource.data.ownerUid == request.auth.uid || inviteTargetMatchesCurrentAccount(resource.id)); allow update: if signedIn() && ((resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid) || (inviteTargetMatchesCurrentAccount(resource.id) && request.resource.data.targetEmail == resource.data.targetEmail && request.resource.data.familyId == resource.data.familyId && request.resource.data.status in ['accepted', 'declined'])); allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid; }
    match /familyApprovals/{approvalId} { allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.familyId == userRecord().get('familyId', '') && request.resource.data.status == 'pending'; allow get: if signedIn() && (isCreator() || resource.data.requesterUid == request.auth.uid || get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerUid == request.auth.uid); allow list: if isCreator(); allow update: if signedIn() && get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedByUid', 'decidedAt']) && request.resource.data.status in ['approved', 'rejected']; allow delete: if false; }
    match /sandboxExperiments/{experimentId} { allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.type in ['genetics', 'pairing', 'clutch', 'custom']; allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid; allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid; }
    match /testerSandboxes/{sandboxId} { allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.syntheticOnly == true && request.resource.data.purpose == "bot-test"; allow get: if signedIn() && resource.data.ownerUid == request.auth.uid; allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid && request.resource.data.syntheticOnly == true; allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid; allow list: if false; match /{document=**} { allow read, write: if signedIn() && get(/databases/$(database)/documents/testerSandboxes/$(sandboxId)).data.ownerUid == request.auth.uid; } }
    match /geneticsCalculations/{calculationId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow get, list: if isCreator(); allow update, delete: if isCreator(); }
    match /supporters/{userId} { allow get: if signedIn() && (request.auth.uid == userId || isCreator()); allow list: if isCreator(); allow create, update, delete: if isCreator(); }
    match /supporterWall/{entryId} { allow read: if signedIn(); allow create, update, delete: if isCreator(); }
    match /supporterStats/{statId} { allow read, write: if isCreator(); }
    match /issueReports/{reportId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow get: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid); allow list: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid); allow update, delete: if isCreator(); match /messages/{messageId} { allow read: if signedIn() && (isCreator() || get(/databases/$(database)/documents/issueReports/$(reportId)).data.userId == request.auth.uid); allow create: if signedIn() && (isCreator() || get(/databases/$(database)/documents/issueReports/$(reportId)).data.userId == request.auth.uid) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == (isCreator() ? "creator" : "user"); allow update, delete: if false; } }
    match /feedback/{feedbackId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow get: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid); allow list: if isCreator(); allow update, delete: if isCreator(); match /messages/{messageId} { allow read: if signedIn() && (isCreator() || get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid); allow create: if signedIn() && (isCreator() || get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == (isCreator() ? "creator" : "user"); allow update, delete: if false; } }
    match /submissionConversations/{conversationId} { allow create: if signedIn() && (isCreator() || request.resource.data.submitterUid == request.auth.uid) && request.resource.data.submissionId is string && request.resource.data.submissionType is string; allow get: if signedIn() && (isCreator() || resource.data.submitterUid == request.auth.uid); allow list: if signedIn() && (isCreator() || resource.data.submitterUid == request.auth.uid); allow update: if signedIn() && (isCreator() || resource.data.submitterUid == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessageAt', 'lastMessagePreview', 'lastSenderRole', 'unreadForSubmitter', 'unreadForCreator', 'submissionStatus']); allow delete: if false; match /messages/{messageId} { allow get, list: if signedIn() && (isCreator() || get(/databases/$(database)/documents/submissionConversations/$(conversationId)).data.submitterUid == request.auth.uid); allow create: if signedIn() && (isCreator() || get(/databases/$(database)/documents/submissionConversations/$(conversationId)).data.submitterUid == request.auth.uid) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == (isCreator() ? "creator" : "user"); allow update, delete: if false; } }
    match /founderApplications/{applicationId} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if isCreator(); }
    match /communityPosts/{postId} { allow read: if signedIn() && (resource.data.audience == "everyone" || (resource.data.audience == "testers" && isTester()) || (resource.data.audience == "educator" && isEducator()) || (resource.data.audience == "moderator" && isModerator()) || (resource.data.audience == "admin" && isCreator())); allow create, update, delete: if isCreator(); }
    match /morphSubmissions/{submissionId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "creating" && request.resource.data.moderationStatus == "pending" && request.resource.data.submissionComplete == false; allow get: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid); allow list: if isCreator(); allow update, delete: if isCreator(); }
    match /morphImageSubmissions/{submissionId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow get: if signedIn() && (request.auth.uid == resource.data.userId || isCreator()); allow list: if isCreator(); allow update, delete: if isCreator(); }
    match /vivariumShowcaseSubmissions/{submissionId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "Pending" && request.resource.data.publicConsent == true; allow get: if signedIn() && (isCreator() || resource.data.userId == request.auth.uid || (resource.data.status == "Approved" && resource.data.publicConsent == true)); allow list: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid) || (signedIn() && resource.data.status == "Approved" && resource.data.publicConsent == true); allow update: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.status == resource.data.status); allow delete: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status != "Approved"); }
    match /{path=**}/morphSubmissions/{submissionId} { allow read: if isCreator(); allow update, delete: if isCreator(); }
    match /approvedMorphImages/{imageId} { allow read: if signedIn(); allow create, update, delete: if isCreator(); }
    match /mentorApplications/{applicationId} { allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid && request.resource.data.status == "submitted" && request.resource.data.mentorRoles.size() > 0 && request.resource.data.specialities.size() > 0 && request.resource.data.experienceYears >= 0 && request.resource.data.experienceYears <= 80 && request.resource.data.conductAccepted == true; allow get: if signedIn() && (isCreator() || resource.data.applicantId == request.auth.uid); allow list: if isCreator(); allow update, delete: if isCreator(); }
    match /mentors/{mentorId} { allow read: if signedIn(); allow create, update, delete: if isCreator(); }
    match /mentorshipRequests/{requestId} { allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid && request.resource.data.status == "sent"; allow get, list: if signedIn() && (isCreator() || resource.data.requesterId == request.auth.uid || resource.data.mentorId == request.auth.uid); allow update: if signedIn() && (isCreator() || resource.data.mentorId == request.auth.uid || resource.data.requesterId == request.auth.uid); allow delete: if isCreator(); }
    match /mentorshipWorkspaces/{workspaceId} { allow create: if signedIn() && (isCreator() || request.resource.data.participants.any(p, p.userId == request.auth.uid)); allow get: if signedIn() && (isCreator() || resource.data.participants.any(p, p.userId == request.auth.uid)); allow list: if false; allow update: if signedIn() && (isCreator() || resource.data.participants.any(p, p.userId == request.auth.uid)); allow delete: if isCreator(); }
    match /mentorshipEvents/{eventId} { allow create: if isCreator(); allow get, list: if isCreator(); allow update, delete: if isCreator(); }
    match /keeperObservations/{observationId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "pending" && request.resource.data.educationalConsent == true; allow get, list: if signedIn() && ((resource.data.status == "approved" && resource.data.educationalConsent == true) || resource.data.userId == request.auth.uid || isCreator()); allow update: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status == "pending" && request.resource.data.status == "pending" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['media', 'updatedAt'])); allow delete: if isCreator() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status == "pending"); }
    match /{document=**} { allow read, write: if false; }
  }
}