# Public URL encoded into printed Rescue QR labels.
# Leave unset to use the Firebase Hosting URL automatically during localhost development.
VITE_PUBLIC_APP_URL=https://tinytitans-hoggy-companion.web.app

# Public reCAPTCHA Enterprise Web site key used by Firebase App Check.
# Create a score-based Web key for the production Firebase Hosting domain(s)
# and register it under Firebase Console -> Security -> App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=


# Optional direct Tiny Titans plugin destination in ChatGPT.
# Keep blank while the plugin is private; the app falls back to the ChatGPT Plugins directory.
# Set this to the published Tiny Titans plugin URL once public.
VITE_CHATGPT_PLUGIN_URL=https://chatgpt.com/plugins/plugins_6ac2654b51e48191af9a0c921d2b8d6e
