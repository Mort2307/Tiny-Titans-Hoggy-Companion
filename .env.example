# Firebase AI Logic / Gemini
# Public reCAPTCHA Enterprise Web site key used by Firebase App Check.
# Create a score-based Web key for the production Firebase Hosting domain(s)
# and register it under Firebase Console -> Security -> App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional model override. Current default in the app is gemini-3.8-flash.
VITE_TT_GEMINI_MODEL=gemini-3.8-flash
