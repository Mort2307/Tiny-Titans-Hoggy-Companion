    function partnerOwner(uid) {
      return signedIn() && request.auth.uid == uid && exists(/databases/$(database)/documents/users/$(uid)) && get(/databases/$(database)/documents/users/$(uid)).data.profileType == 'professional';
    }
    match /partnerLandings/{landingId} {
      allow get: if resource.data.publicEnabled == true || (isCreator() && resource.data.recordType == 'owner') || partnerOwner(resource.data.ownerUid);
      allow list: if isCreator() && resource.data.recordType == 'owner';
      allow create: if partnerOwner(request.resource.data.ownerUid) && request.resource.data.recordType == 'owner';
      allow update: if isCreator() || (partnerOwner(resource.data.ownerUid) && resource.data.recordType == 'owner' && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.recordType == 'owner');
      allow delete: if isCreator() || (partnerOwner(resource.data.ownerUid) && resource.data.recordType == 'owner');
    }
    match /qaRuns/{runId} {
      allow get, list: if isCreator();
      allow create, update: if isCreator();
      allow delete: if isCreator();
    }
