rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasCreatorClaim() {
      return signedIn() && (
        request.auth.token.creator == true ||
        request.auth.token.admin == true ||
        request.auth.token.moderator == true
      );
    }

    match /users/{userId}/snakes/{snakeId}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/snakes/{snakeId}/sheds/{shedId}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /morph-submissions/{userId}/{submissionId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || hasCreatorClaim());
    }

    match /issueEvidence/{userId}/{reportId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || hasCreatorClaim());
    }

    match /morphLibrary/{morphId}/community/{fileName} {
      allow read: if signedIn();
      allow write: if hasCreatorClaim();
    }
  }
}
