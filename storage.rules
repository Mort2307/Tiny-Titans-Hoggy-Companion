rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function creatorRecord() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isCreator() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.creator == true
          || creatorRecord().role == "admin"
          || creatorRecord().role == "creator"
          || creatorRecord().profileType == "creator"
        );
    }

    match /users/{userId}/snakes/{snakeId}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /morph-submissions/{userId}/{submissionId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || isCreator());
    }

    match /issueEvidence/{userId}/{reportId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || isCreator());
    }

    match /morphLibrary/{morphId}/community/{fileName} {
      allow read: if signedIn();
      allow write: if isCreator();
    }
  }
}
