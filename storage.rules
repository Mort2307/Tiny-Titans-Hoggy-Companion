rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function creatorRecord() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function ownerAccount() { return signedIn() && request.auth.token.email == 'tinytitans.exotics@gmail.com'; }
    function isCreator() { return ownerAccount() && (request.auth.token.admin == true || request.auth.token.creator == true); }
    function canAccessUserFiles(userId) { return signedIn() && (request.auth.uid == userId || (creatorRecord().get('familyId', '') != '' && creatorRecord().get('familyId', '') == firestore.get(/databases/(default)/documents/users/$(userId)).data.get('familyId', '') && firestore.get(/databases/(default)/documents/families/$(creatorRecord().get('familyId', ''))).data.memberUids.hasAll([request.auth.uid, userId])) || isCreator()); }
    function rescueBrandingEditor(orgId) {
      let org = firestore.get(/databases/(default)/documents/rescueOrganisations/$(orgId)).data;
      return signedIn()
        && (org.get('ownerUid', '') == request.auth.uid || request.auth.uid in org.get('managerUids', []) || request.auth.uid in org.get('staffUids', []) || request.auth.uid in org.get('medicalUids', []))
        && (ownerAccount() || org.get('accountStatus', '') == 'paid_active' || (org.get('pilotStatus', '') == 'pilot_active' && org.get('pilotEndsAt', null) > request.time));
    }

    match /users/{userId}/snakes/{snakeId}/{fileName} {
      allow read: if canAccessUserFiles(userId);
      allow create, update: if canAccessUserFiles(userId)
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches("^image/(jpeg|png|webp)$");
      allow delete: if canAccessUserFiles(userId);
    }
    match /snakePhotos/{userId}/{snakeId}/{fileName} {
      allow read: if canAccessUserFiles(userId);
      allow create, update: if canAccessUserFiles(userId)
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches("^image/(jpeg|png|webp)$");
      allow delete: if canAccessUserFiles(userId);
    }
    match /users/{userId}/reptileRooms/{roomId}/vivariums/{fileName} {
      allow read: if canAccessUserFiles(userId);
      allow create, update: if canAccessUserFiles(userId)
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches("^image/(jpeg|png|webp)$");
      allow delete: if canAccessUserFiles(userId);
    }
    match /users/{userId}/reptileRooms/{roomId}/assets/{fileName} {
      allow read: if canAccessUserFiles(userId);
      allow create, update: if canAccessUserFiles(userId)
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches("^image/(jpeg|png|webp)$");
      allow delete: if canAccessUserFiles(userId);
    }
    match /morph-submissions/{userId}/{submissionId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId && request.resource.size <= 25 * 1024 * 1024 && request.resource.contentType.matches('^(image/(jpeg|png|webp|heic|heif)|video/(mp4|webm|quicktime))$');
      allow read: if signedIn() && (request.auth.uid == userId || isCreator());
    }
    match /issueEvidence/{userId}/{reportId}/{fileName} { allow write: if signedIn() && request.auth.uid == userId && request.resource.size <= 25 * 1024 * 1024; allow read: if signedIn() && (request.auth.uid == userId || isCreator()); }
    match /keeper-observations/{userId}/{observationId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId && request.resource.size <= 100 * 1024 * 1024 && request.resource.contentType.matches('^(video/(mp4|webm|quicktime)|image/(jpeg|png|webp))$');
      allow read: if signedIn() && (request.auth.uid == userId || isCreator());
    }
    match /morphLibrary/{speciesId}/{morphId}/community/{fileName} { allow read: if signedIn(); allow write: if isCreator(); }
    match /morphLibrary/{morphId}/community/{fileName} { allow read: if signedIn(); allow write: if isCreator(); }
    match /rescueBranding/{organisationId}/{fileName} {
      allow read: if true;
      allow create, update: if rescueBrandingEditor(organisationId)
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');
      allow delete: if rescueBrandingEditor(organisationId);
    }
    match /qa-evidence/{runId}/{fileName=**} {
      allow read, write: if isCreator();
    }
  }
}