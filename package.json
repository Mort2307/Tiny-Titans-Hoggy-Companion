{
  "name": "tinytitans-reptile-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:morphs": "node scripts/validate-morph-database.mjs",
    "validate:morph-taxonomy": "node scripts/validate-hognose-morph-taxonomy.mjs",
    "validate:morph-sources": "node scripts/validate-morph-source-audit.mjs",
    "validate:morph-integrity": "node scripts/validate-morph-integrity.mjs",
    "validate:morph-intelligence": "node scripts/validate-morph-intelligence.mjs",
    "validate:species": "node scripts/validate-species-database.mjs",
    "validate:species-husbandry": "node scripts/validate-species-husbandry.mjs",
    "validate:species-evidence": "node scripts/validate-species-evidence.mjs",
    "validate:species-genetics": "node scripts/validate-species-genetics.mjs",
    "validate:species-genetics-coverage": "node scripts/validate-species-genetics-coverage.mjs",
    "validate:species-genetics-audit": "node scripts/audit-species-genetics.mjs",
    "validate:species-integration": "node scripts/validate-species-integration.mjs",
    "validate:submissions": "node scripts/validate-submission-contracts.mjs",
    "validate:breeding-bridge": "node scripts/validate-breeding-genetics-bridge.mjs",
    "validate:app-health": "node scripts/validate-app-health-contracts.mjs",
    "validate:learning": "node scripts/validate-learning-content.mjs",
    "validate:routes": "node scripts/check-route-contracts.mjs",
    "validate:route-coverage": "node scripts/check-route-coverage.mjs",
    "validate:v50-routes": "node scripts/validate-v50-feature-routes.mjs",
    "validate:encoding": "node scripts/check-mojibake.mjs",
    "validate:copy-quality": "node scripts/audit-ui-copy.mjs",
    "validate:security": "node scripts/validate-security-contracts.mjs",
    "validate:ui-hardening": "node scripts/validate-ui-hardening.mjs",
    "validate:observatory": "node scripts/validate-behaviour-observatory.mjs",
    "validate:genetics-calculator-v2": "node scripts/validate-genetics-calculator-v2.mjs",
    "monitor:species-sources": "node scripts/check-species-source-health.mjs",
    "test:intelligence:consent": "node scripts/test-intelligence-consent-contracts.mjs",
    "test:intelligence:journey": "node scripts/test-intelligence-journey-contracts.mjs",
    "test:intelligence:proactive": "node scripts/test-titan-proactive-engine.mjs",
    "validate:intelligence-consent": "npm run test:intelligence:consent",
    "validate:intelligence-journey": "npm run test:intelligence:journey",
    "test:notifications": "node scripts/test-notification-delivery-contracts.mjs",
    "test:room-photo": "node scripts/check-room-photo-render-contract.mjs",
    "test:bot:contracts": "node scripts/run-bot-test-contract.mjs",
    "test:overlord": "node scripts/run-overlord-bot.mjs",
    "test:visual-ux": "node scripts/run-visual-ux-bot.mjs",
    "test:production-gate": "node scripts/run-production-gate.mjs",
    "test": "npm run test:bot:contracts && npm run test:intelligence:consent && npm run test:intelligence:journey && npm run test:intelligence:proactive && npm run test:notifications && npm run test:room-photo",
    "audit": "npm audit --audit-level=high",
    "build": "npm run validate:morphs && npm run validate:morph-taxonomy && npm run validate:morph-sources && npm run validate:morph-integrity && npm run validate:morph-intelligence && npm run validate:species && npm run validate:species-husbandry && npm run validate:species-evidence && npm run validate:species-genetics && npm run validate:species-genetics-coverage && npm run validate:species-genetics-audit && npm run validate:species-integration && npm run validate:submissions && npm run validate:breeding-bridge && npm run validate:app-health && npm run validate:learning && npm run validate:routes && npm run validate:route-coverage && npm run validate:v50-routes && npm run validate:encoding && npm run validate:copy-quality && npm run validate:security && npm run validate:ui-hardening && npm run validate:observatory && npm run validate:genetics-calculator-v2 && npm run test:intelligence:consent && npm run test:intelligence:journey && npm run test:intelligence:proactive && npm run test:notifications && npm run test:room-photo && tsc -b && vite build",
    "lint": "eslint .",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "npm run build && firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore,storage",
    "deploy:app": "npm run build && firebase deploy --only hosting,functions,firestore,storage"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "firebase": "^12.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-globe.gl": "^2.37.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
